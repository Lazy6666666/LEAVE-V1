# Production Environment Configuration
# Copy this file to .env.production and fill in actual values

# ============================================
# Supabase Configuration
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================
# Database Configuration
# ============================================
# Use connection pooling for production
DATABASE_URL=postgresql://postgres.your-project-id:@aws-0-us-east-1.pooler.supabase.com:6543/postgres?connection_limit=20&pool_timeout=20
DIRECT_URL=postgresql://postgres.your-project-id:@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ============================================
# Security Configuration
# ============================================
# Generate strong secrets for production
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-characters-long
CSRF_SECRET=your-csrf-secret-at-least-32-characters-long
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
DOMAIN=yourdomain.com
URL=https://yourdomain.com

# ============================================
# Email Configuration (if using email notifications)
# ============================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Leave Management System

# ============================================
# File Storage Configuration
# ============================================
# If using external storage (S3, etc.)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================
# Rate Limiting Configuration
# ============================================
# Configure Redis for distributed rate limiting
REDIS_URL=redis://username:password@your-redis-host:6379
REDIS_PASSWORD=your-redis-password

# ============================================
# Monitoring & Analytics
# ============================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# Logging Configuration
# ============================================
# External logging service
LOGTAIL_SOURCE_TOKEN=your-logtail-token
ELASTIC_APM_SECRET_TOKEN=your-elastic-apm-token

# ============================================
# Performance Monitoring
# ============================================
# Bundle analyzer
ANALYZE=false

# ============================================
# Security Headers Configuration
# ============================================
# Enable/disable security features
ENABLE_CSP=true
ENABLE_HSTS=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true

# ============================================
# Feature Flags
# ============================================
# Enable/disable features in production
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
ENABLE_SEARCH=true
ENABLE_CALENDAR=true

# ============================================
# Backup Configuration
# ============================================
# Database backup settings
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key